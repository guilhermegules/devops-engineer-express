# Vagrant dirs
.vagrant

# Ignore RPM files
*.rpm

#Ignore ansible RETRY files
*.retry

# Prerequisites
*.d
# Jenkins seeding scripts live in init.groovy.d, which the rule above would swallow
!homework/16-stress-test-chaos/jenkins/init.groovy.d/
!homework/16-stress-test-chaos/jenkins/init.groovy.d/*.groovy

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf
