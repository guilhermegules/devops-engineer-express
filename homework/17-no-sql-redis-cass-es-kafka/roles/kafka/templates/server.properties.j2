# Managed by Ansible - homework 17 (roles/kafka).
# Single-node KRaft cluster: the same process is broker and controller.
process.roles=broker,controller
node.id={{ kafka_node_id }}
controller.quorum.voters={{ kafka_node_id }}@{{ kafka_advertised_host }}:{{ kafka_controller_port }}

listeners=PLAINTEXT://:{{ kafka_port }},CONTROLLER://:{{ kafka_controller_port }}
advertised.listeners=PLAINTEXT://{{ kafka_advertised_host }}:{{ kafka_port }}
inter.broker.listener.name=PLAINTEXT
controller.listener.names=CONTROLLER
listener.security.protocol.map=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT

log.dirs={{ kafka_data_dir }}

# Replication factors of 1 because there is only one broker.
num.partitions=1
num.recovery.threads.per.data.dir=1
offsets.topic.replication.factor=1
transaction.state.log.replication.factor=1
transaction.state.log.min.isr=1

# Keep the defaults modest for a homework box.
log.retention.hours=168
log.segment.bytes=1073741824
log.retention.check.interval.ms=300000
